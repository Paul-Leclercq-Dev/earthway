# API Backend URL
VITE_API_URL="/api"

# Stripe Publishable Key (from backend .env)
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"

# Google OAuth Client ID (for frontend OAuth flow)
VITE_GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# App Environment
VITE_APP_ENV="development"

# App Version
VITE_APP_VERSION="1.0.0"

# PWA Configuration
VITE_APP_NAME="Earthway"
VITE_APP_SHORT_NAME="Earthway"
VITE_APP_DESCRIPTION="Plateforme de sensibilisation environnementale"
VITE_APP_THEME_COLOR="#10b981"
VITE_APP_BACKGROUND_COLOR="#ffffff"

# Ads Configuration (RGPD - only shown to non-subscribers with consent)
# Values: adsense | medianet | none
VITE_AD_PROVIDER=none
VITE_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
VITE_ADSENSE_SLOT_FEED=
VITE_ADSENSE_SLOT_DISPLAY=
